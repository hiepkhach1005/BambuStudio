# iOS arm64 device toolchain for BambuStudio deps (I1a).
# Usage: cmake -DCMAKE_TOOLCHAIN_FILE=ios/cmake/ios-toolchain.cmake (env IOS_DEPS_PREFIX=<prefix>)
set(CMAKE_SYSTEM_NAME iOS)
set(CMAKE_OSX_SYSROOT iphoneos CACHE STRING "")
set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "")
set(CMAKE_OSX_DEPLOYMENT_TARGET 18.0 CACHE STRING "")
set(CMAKE_SYSTEM_PROCESSOR arm64)   # libjpeg-turbo needs it non-empty
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
set(CMAKE_BUILD_TYPE Release CACHE STRING "")
set(BUILD_SHARED_LIBS OFF CACHE BOOL "")
if(DEFINED ENV{IOS_DEPS_PREFIX})
  set(IOS_DEPS_PREFIX "$ENV{IOS_DEPS_PREFIX}")
endif()
if(IOS_DEPS_PREFIX)
  list(PREPEND CMAKE_PREFIX_PATH "${IOS_DEPS_PREFIX}")
  set(CMAKE_FIND_ROOT_PATH "${IOS_DEPS_PREFIX}")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
